{
  "name": "random-walk-website-v1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "browserslist": [
    "defaults",
    "not dead",
    "supports es6-module"
  ],
  "scripts": {
    "dev": "next dev",
    "refresh:melix": "node scripts/fetch-melix-metadata.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "fonts:cjk": "node scripts/fetch-cjk-fonts.mjs",
    "prebuild": "bun run refresh:melix && bun run fonts:cjk",
    "build": "next build",
    "lint": "eslint .",
    "test": "bun test lib/contact-schema.test.ts lib/meet.test.ts lib/cal-booking.test.ts lib/meet-capacity.test.ts lib/content.test.ts lib/visual-assets.test.ts lib/public-copy.test.ts lib/image-loader.test.ts lib/site-structure.test.ts",
    "visual:check": "node scripts/visual-check.mjs",
    "og:images": "bun scripts/og-images.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^12.40.0",
    "next": "15.5.16",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "20.19.31",
    "@types/react": "19.2.11",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.16",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
